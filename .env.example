# Official contact details must be confirmed by Edumate before being published.
# Leave these values empty until verification. Do not enter invented details.

# Phone number in international format, e.g. +91XXXXXXXXXX
VITE_CONTACT_PHONE=

# Public enquiry email address
VITE_CONTACT_EMAIL=

# WhatsApp number in international format without spaces or "+", e.g. 91XXXXXXXXXX
VITE_WHATSAPP_NUMBER=

# Enquiry form delivery endpoint (Formspree, Basin, custom API, etc.).
# The form posts JSON and expects a 2xx response.
VITE_ENQUIRY_ENDPOINT=
